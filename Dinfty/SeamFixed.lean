import Dinfty.CopyHierarchy

open GluingTowerLibrary SierpinskiApplication

/-!
# Copy `A` is a principal ideal

`EmbTagwise` showed the tower's embeddings preserve the copy index, and asked
whether a bounded join-embedding `f : D (k+1) → D (m+1)` must too.  This module
names the point the question turns on, and records which half of it is free.

## The seam point

```lean
cSeam k : D (k+1) := glueA (markedPt k) ⊤
```

is the tag-`A` copy of `⊤` — the same glued point as the tag-`C` copy of `⊥`
(`Gasket.tagC_bot_eq_top`'s general shape).  It is the **greatest copy-`A`
point**, and copy `A` is exactly the principal ideal it generates:

```lean
mem_copyA_iff_le_cSeam (k) (x) : (∃ a, x.1 = Sum.inl a) ↔ x ≤ cSeam k
```

`←` is `CopyHierarchy.tagA_source` (copy `A` is a down-set); `→` is the `a → a`
clause of `rawRuleGen` at `⊤`.

## The consequence

An order-reflecting `f` that fixes the seam point preserves the copy-`A` split,
**in both directions and with no other hypothesis**:

```lean
copyA_preserved (f) (hmono) (hrefl) (hseam : f (cSeam k) = cSeam m) (x) :
  (∃ a, (f x).1 = Sum.inl a) ↔ (∃ a, x.1 = Sum.inl a)
```

`x ≤ cSeam k ↔ f x ≤ f (cSeam k) = cSeam m`, and both sides are membership in
copy `A` by the ideal description.  Neither `⊥`, `⊤`, nor the joins are used —
only order reflection and the one equation.

## Recorded so it is not retried: `embD` does **not** fix the seam point

The tempting move is to name `f (cSeam k) = cSeam m` as the residue.  **That
statement is false for the canonical map itself.**  `glueAA 0`'s copy-`A` payload
map is `iotaEndPGen hbt f = fun w => iotaGen (f (pGen w))`, whose values always
lie in the image of `iotaGen`, so it never reaches `⊤`
(`ProjectionTripointed.iotaEndP_top_ne_top`).  Hence `embD h (cSeam k)` is
strictly below `cSeam m`, and only the **one-directional** hypothesis survives:

```lean
copyA_mapsTo (f) (hmono) (hseam : f (cSeam k) ≤ cSeam m) : copy A ↦ copy A
```

which is what `embD` satisfies.  The converse — that `f` cannot pull a copy-`B`
or copy-`C` point back into copy `A` — is the part still open, and it is a
statement about `f` not collapsing tags, not about a single point.

The copy-`B` caveat is unchanged: `tag_B ⊤` and `tag_C m` are the *same* glued
point (`occsGen`), so the copy index is only well defined away from that seam,
exactly as `CopyHierarchy.copyIdx_mono` records.
-/

open Set

open scoped Classical

namespace SeamFixed

universe u

/-! ## 1.  Every point occurs among its own occurrences -/

section Generic

variable {P : Type u} [DecidableEq P] [PartialOrder P] [BoundedOrder P]

-- `self_mem_occsGen` is `GluingTowerLibrary.self_mem_occsGen`; the re-proof that used to sit here was removed 2026-09-01 (identical statement).

/-- The `a → a` clause of `rawRuleGen`, at `⊤`. -/
theorem leGlueGen_tagA_top (m a : P) : leGlueGen m (Sum.inl a) (Sum.inl ⊤) :=
  ⟨Sum.inl a, self_mem_occsGen m _, Sum.inl ⊤, self_mem_occsGen m _, le_top⟩

end Generic

/-! ## 2.  The seam point of a level, and copy `A` as a principal ideal -/

open CopyHierarchy

/-- The greatest copy-`A` point of `D (k+1)`: the tag-`A` copy of `⊤`. -/
noncomputable def cSeam (k : ℕ) : D (k + 1) := glueA (markedPt k) (⊤ : EndP (D k))

@[simp] theorem cSeam_val (k : ℕ) : (cSeam k).1 = Sum.inl (⊤ : EndP (D k)) := rfl

theorem le_cSeam_of_tagA (k : ℕ) {x : D (k + 1)} {a : EndP (D k)}
    (hx : x.1 = Sum.inl a) : x ≤ cSeam k := by
  show leGlueGen (markedPt k) x.1 (cSeam k).1
  rw [hx, cSeam_val]
  exact leGlueGen_tagA_top _ a

theorem tagA_of_le_cSeam (k : ℕ) {x : D (k + 1)} (h : x ≤ cSeam k) :
    ∃ a : EndP (D k), x.1 = Sum.inl a := by
  have hle : leGlueGen (markedPt k) x.1 (Sum.inl (⊤ : EndP (D k))) := h
  exact tagA_source (markedPt k) (D_marked_point_nondegenerate k).1
    (D_marked_point_nondegenerate k).2.2 x.2 hle

/-- **Copy `A` is the principal ideal generated by the seam point.** -/
theorem mem_copyA_iff_le_cSeam (k : ℕ) (x : D (k + 1)) :
    (∃ a : EndP (D k), x.1 = Sum.inl a) ↔ x ≤ cSeam k :=
  ⟨fun ⟨a, ha⟩ => le_cSeam_of_tagA k ha, fun h => tagA_of_le_cSeam k h⟩

/-! ## 3.  One point pins the copy-`A` split -/

/-- **The reduction.**  An order-reflecting map fixing the seam point preserves
copy `A` exactly — in both directions, and using nothing else. -/
theorem copyA_preserved {k m : ℕ} (f : D (k + 1) → D (m + 1)) (hmono : Monotone f)
    (hrefl : ∀ a b, f a ≤ f b → a ≤ b) (hseam : f (cSeam k) = cSeam m)
    (x : D (k + 1)) :
    (∃ a : EndP (D m), (f x).1 = Sum.inl a) ↔ (∃ a : EndP (D k), x.1 = Sum.inl a) := by
  rw [mem_copyA_iff_le_cSeam, mem_copyA_iff_le_cSeam]
  constructor
  · intro h
    refine hrefl x (cSeam k) ?_
    rw [hseam]
    exact h
  · intro h
    rw [← hseam]
    exact hmono h

/-- **The useful direction, with the hypothesis `embD` actually satisfies.** -/
theorem copyA_mapsTo {k m : ℕ} (f : D (k + 1) → D (m + 1)) (hmono : Monotone f)
    (hseam : f (cSeam k) ≤ cSeam m) (x : D (k + 1))
    (hx : ∃ a : EndP (D k), x.1 = Sum.inl a) :
    ∃ a : EndP (D m), (f x).1 = Sum.inl a := by
  rw [mem_copyA_iff_le_cSeam] at hx ⊢
  exact le_trans (hmono hx) hseam

end SeamFixed
