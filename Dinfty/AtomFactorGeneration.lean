import Dinfty.WeakProductAbsorption

/-!
# Generation by atom-factors — the invariant that survives past level 1

`WeakProductAbsorption` used the atom-factor to see a `C₂` that a restricted
product cannot absorb.  Pushing that to seed separation needs a *finer*
invariant, and the coarse one provably fails.

## Why the multiset is not enough

The seed of a join-irreducible `z = toD N y` has the shape

    (JBelow z)ᵒᵖ  ≅  (⨁_{j ≥ N} D j) × S_y ,     S_y := (J(↓y in D N))ᵒᵖ

and atom-factors split over products, so the multiset of atom-factors is
`{D j : j ≥ N} ⊎ atomFactors S_y`.  At `N = 1` that already pins both points
(`_archive/check_atom_factor_seed_separation.py`: unique among all 16
join-irreducibles of the real `D 1`).

**At `N = 2` it does not.**  The predicted shapes are
`S_{dMid 2} ≅ D 1 × D 0` and `S_{tag_B m} ≅ (D 1 × D 0) ⊕ (D 1 × D 0)`
(ordinal sum), and `tag_B m` *is* a join-irreducible of `D 2`.  In an ordinal
sum `A ⊕ B` whose bottom part has two or more atoms, every atom-factor lies
inside `A` and **`B` is invisible**: both posets have atom-factor multiset
`{D 1, D 0}`.  Verified in
`_archive/check_atom_factor_level2_and_generation.py`.

## The refinement

```lean
GenByFactors L : ∀ w, IsLUB {u | u ∈ factorPart L ∧ u ≤ w} w
```

— every element is the least upper bound of the factor elements below it.  It
is an order-theoretic property (`genByFactors_orderIso`), and it separates
exactly the two cases above:

* a restricted product **is** generated by its atom-factors
  (`genByFactors_weakProd`), because `w = ⋁ⱼ single j (w j)`;
* an ordinal sum with a non-empty top part is **not**
  (`not_genByFactors_of_strict_upper`): the top of `A` bounds every factor
  element, so nothing above it can be a least upper bound of them.

That second lemma is three lines and is the whole content of the copy-`B` and
copy-`C` exclusions: those seeds put *all* of `J(↓ marked point)` above the
part that carries the factors.

`genByFactors_prod_iff` makes the invariant multiplicative, so the `⨁` prefix
is transparent and the question lands entirely on `S_y`.

## The criterion this yields

```lean
weakProd_prod_ne : ¬ GenByFactors S → IsEmpty (WeakProd D ≃o (WeakProd D × S))
```

So a stage-`N` competitor is excluded as soon as its finite seed `S_y` fails
generation — which is what copies `B` and `C` do, at every level.

## Scope

This is the **engine**, and it is machine-checked.  What is *not* formalised is
the input: that `(JBelow z)ᵒᵖ` really has the product shape above.  That bridge
is the down-set / join-irreducible recursion carried to the colimit, and until
it exists in Lean, `TwoPointFixed` stays open.  See
`Dinfty/SeedShape.lean` for the hypothesis stated as a `Prop` and the argument
run against it.
-/

open scoped Classical

universe u v

namespace AtomFactorGeneration

open WeakProductAbsorption

/-! ## The factor part, and generation -/

variable {L : Type u} [PartialOrder L] [OrderBot L]

/-- The union of all atom-factors. -/
def factorPart (L : Type u) [PartialOrder L] [OrderBot L] : Set L :=
  {w | ∃ α : L, IsAtom α ∧ w ∈ atomFactor L α}

/-- **Generated by its atom-factors**: every element is the least upper bound of
the factor elements below it. -/
def GenByFactors (L : Type u) [PartialOrder L] [OrderBot L] : Prop :=
  ∀ w : L, IsLUB {u : L | u ∈ factorPart L ∧ u ≤ w} w

/-! ## It is an order-theoretic property -/

theorem mem_factorPart_map {L' : Type v} [PartialOrder L'] [OrderBot L']
    (e : L ≃o L') {w : L} (hw : w ∈ factorPart L) : e w ∈ factorPart L' := by
  obtain ⟨α, hα, hmem⟩ := hw
  exact ⟨e α, orderIso_isAtom e hα, mem_atomFactor_map e α hmem⟩

theorem factorPart_image {L' : Type v} [PartialOrder L'] [OrderBot L']
    (e : L ≃o L') : e '' factorPart L = factorPart L' := by
  ext y
  constructor
  · rintro ⟨w, hw, rfl⟩
    exact mem_factorPart_map e hw
  · intro hy
    refine ⟨e.symm y, ?_, e.apply_symm_apply y⟩
    have h := mem_factorPart_map e.symm hy
    exact h

/-- **Generation transports along an order-isomorphism.** -/
theorem genByFactors_orderIso {L' : Type v} [PartialOrder L'] [OrderBot L']
    (e : L ≃o L') (h : GenByFactors L) : GenByFactors L' := by
  intro w
  constructor
  · rintro u ⟨hu, hle⟩
    exact hle
  · intro v hv
    have hkey : e.symm w ≤ e.symm v := by
      refine (h (e.symm w)).2 ?_
      rintro u ⟨hu, hle⟩
      have h1 : e u ∈ factorPart L' := mem_factorPart_map e hu
      have h2 : e u ≤ w := by
        have := e.monotone hle
        rwa [e.apply_symm_apply] at this
      have h3 : e u ≤ v := hv ⟨h1, h2⟩
      have := e.symm.monotone h3
      rwa [e.symm_apply_apply] at this
    have := e.monotone hkey
    rwa [e.apply_symm_apply, e.apply_symm_apply] at this

/-- **Non-isomorphism from generation.** -/
theorem no_iso_of_genByFactors_ne {L' : Type v} [PartialOrder L'] [OrderBot L']
    (h : GenByFactors L) (h' : ¬ GenByFactors L') : IsEmpty (L ≃o L') :=
  ⟨fun e => h' (genByFactors_orderIso e h)⟩

/-! ## The ordinal-sum obstruction, in the form that is actually used -/

/-- **If some element bounds every factor element and something sits strictly
above it, generation fails.**

This is the whole content of the copy-`B` / copy-`C` exclusion: those seeds are
ordinal sums `A ⊕ B` whose factors all lie in `A`, so `⊤ A` bounds every factor
element while `B` sits strictly above it. -/
theorem not_genByFactors_of_strict_upper {t w : L}
    (ht : ∀ u ∈ factorPart L, u ≤ t) (hlt : t < w) : ¬ GenByFactors L := by
  intro h
  have hub : t ∈ upperBounds {u : L | u ∈ factorPart L ∧ u ≤ w} := by
    rintro u ⟨hu, -⟩
    exact ht u hu
  exact absurd (le_antisymm ((h w).2 hub) (le_of_lt hlt)) (ne_of_gt hlt)

/-! ## Multiplicativity -/

section Prod

variable {A : Type u} {B : Type u} [PartialOrder A] [OrderBot A] [PartialOrder B]
  [OrderBot B]

/-- Atoms of a product, with no finiteness — `ProdAut.prod_isAtom_iff` carries
`Fintype` hypotheses it does not use, and they are unavailable here. -/
theorem prodIsAtom_iff {p : A × B} :
    IsAtom p ↔ (IsAtom p.1 ∧ p.2 = ⊥) ∨ (p.1 = ⊥ ∧ IsAtom p.2) := by
  obtain ⟨a, b⟩ := p
  constructor
  · intro hp
    by_cases ha : a = ⊥
    · subst ha
      refine Or.inr ⟨rfl, ⟨?_, ?_⟩⟩
      · intro hb
        exact hp.1 (Prod.ext rfl hb)
      · intro y hy
        have : ((⊥ : A), y) < ((⊥ : A), b) := by
          refine lt_of_le_of_ne ⟨le_rfl, le_of_lt hy⟩ ?_
          intro hcon
          exact absurd (congrArg Prod.snd hcon) (ne_of_lt hy)
        exact congrArg Prod.snd (hp.2 _ this)
    · have hb : b = ⊥ := by
        by_contra hbne
        have hlt : ((a : A), (⊥ : B)) < (a, b) := by
          refine lt_of_le_of_ne ⟨le_rfl, bot_le⟩ ?_
          intro hcon
          exact hbne (congrArg Prod.snd hcon).symm
        exact ha (congrArg Prod.fst (hp.2 _ hlt))
      subst hb
      refine Or.inl ⟨⟨ha, ?_⟩, rfl⟩
      intro x hx
      have : ((x : A), (⊥ : B)) < (a, ⊥) := by
        refine lt_of_le_of_ne ⟨le_of_lt hx, le_rfl⟩ ?_
        intro hcon
        exact absurd (congrArg Prod.fst hcon) (ne_of_lt hx)
      exact congrArg Prod.fst (hp.2 _ this)
  · rintro (⟨ha, rfl⟩ | ⟨rfl, hb⟩)
    · refine ⟨?_, ?_⟩
      · intro hcon
        exact ha.1 (congrArg Prod.fst hcon)
      · rintro ⟨x, y⟩ hlt
        have hle := le_of_lt hlt
        have hy : y = ⊥ := le_bot_iff.mp hle.2
        subst hy
        have hxa : x ≠ a := by
          intro hcon
          subst hcon
          exact absurd rfl (ne_of_lt hlt)
        rw [ha.2 x (lt_of_le_of_ne hle.1 hxa)]
        rfl
    · refine ⟨?_, ?_⟩
      · intro hcon
        exact hb.1 (congrArg Prod.snd hcon)
      · rintro ⟨x, y⟩ hlt
        have hle := le_of_lt hlt
        have hx : x = ⊥ := le_bot_iff.mp hle.1
        subst hx
        have hyb : y ≠ b := by
          intro hcon
          subst hcon
          exact absurd rfl (ne_of_lt hlt)
        rw [hb.2 y (lt_of_le_of_ne hle.2 hyb)]
        rfl

variable [IsAtomic A] [IsAtomic B]

theorem mem_factorPart_prod {p : A × B} :
    p ∈ factorPart (A × B) ↔
      (p.2 = ⊥ ∧ p.1 ∈ factorPart A) ∨ (p.1 = ⊥ ∧ p.2 ∈ factorPart B) := by
  constructor
  · rintro ⟨γ, hγ, hmem⟩
    rcases prodIsAtom_iff.mp hγ with ⟨hγ1, hγ2⟩ | ⟨hγ1, hγ2⟩
    · refine Or.inl ⟨?_, ⟨γ.1, hγ1, ?_⟩⟩
      · by_contra hbne
        obtain ⟨β, hβ, hβle⟩ := (IsAtomic.eq_bot_or_exists_atom_le p.2).resolve_left hbne
        have hat : IsAtom (((⊥ : A), β) : A × B) := prodIsAtom_iff.mpr (Or.inr ⟨rfl, hβ⟩)
        have heq := hmem _ hat ⟨bot_le, hβle⟩
        have h2 : β = γ.2 := congrArg Prod.snd heq
        rw [hγ2] at h2
        exact hβ.1 h2
      · intro α hα hαle
        have hat : IsAtom ((α, (⊥ : B)) : A × B) := prodIsAtom_iff.mpr (Or.inl ⟨hα, rfl⟩)
        exact congrArg Prod.fst (hmem _ hat ⟨hαle, bot_le⟩)
    · refine Or.inr ⟨?_, ⟨γ.2, hγ2, ?_⟩⟩
      · by_contra hane
        obtain ⟨α, hα, hαle⟩ := (IsAtomic.eq_bot_or_exists_atom_le p.1).resolve_left hane
        have hat : IsAtom ((α, (⊥ : B)) : A × B) := prodIsAtom_iff.mpr (Or.inl ⟨hα, rfl⟩)
        have heq := hmem _ hat ⟨hαle, bot_le⟩
        have h2 : α = γ.1 := congrArg Prod.fst heq
        rw [hγ1] at h2
        exact hα.1 h2
      · intro β hβ hβle
        have hat : IsAtom (((⊥ : A), β) : A × B) := prodIsAtom_iff.mpr (Or.inr ⟨rfl, hβ⟩)
        exact congrArg Prod.snd (hmem _ hat ⟨bot_le, hβle⟩)
  · rintro (⟨hb, α, hα, hmem⟩ | ⟨ha, β, hβ, hmem⟩)
    · refine ⟨(α, ⊥), prodIsAtom_iff.mpr (Or.inl ⟨hα, rfl⟩), ?_⟩
      rintro ⟨c, d⟩ hcd hle
      rcases prodIsAtom_iff.mp hcd with ⟨hc, hd⟩ | ⟨hc, hd⟩
      · exact Prod.ext (hmem c hc hle.1) hd
      · exfalso
        have h2 : d ≤ (⊥ : B) := by rw [← hb]; exact hle.2
        exact hd.1 (le_bot_iff.mp h2)
    · refine ⟨(⊥, β), prodIsAtom_iff.mpr (Or.inr ⟨rfl, hβ⟩), ?_⟩
      rintro ⟨c, d⟩ hcd hle
      rcases prodIsAtom_iff.mp hcd with ⟨hc, hd⟩ | ⟨hc, hd⟩
      · exfalso
        have h2 : c ≤ (⊥ : A) := by rw [← ha]; exact hle.1
        exact hc.1 (le_bot_iff.mp h2)
      · exact Prod.ext hc (hmem d hd hle.2)

/-- **Generation is multiplicative**, so a `⨁` prefix is transparent and the
question lands on the other factor. -/
theorem genByFactors_prod_iff :
    GenByFactors (A × B) ↔ GenByFactors A ∧ GenByFactors B := by
  constructor
  · intro h
    constructor
    · intro a
      refine ⟨fun u hu => hu.2, ?_⟩
      intro v hv
      have hub : ((v, (⊥ : B)) : A × B)
          ∈ upperBounds {u : A × B | u ∈ factorPart (A × B) ∧ u ≤ (a, (⊥ : B))} := by
        rintro ⟨c, d⟩ ⟨hcd, hle⟩
        have hd : d = ⊥ := le_bot_iff.mp hle.2
        subst hd
        rcases mem_factorPart_prod.mp hcd with ⟨-, hc⟩ | ⟨hc, -⟩
        · exact ⟨hv ⟨hc, hle.1⟩, le_rfl⟩
        · refine ⟨?_, le_rfl⟩
          rw [hc]
          exact bot_le
      exact ((h (a, (⊥ : B))).2 hub).1
    · intro b
      refine ⟨fun u hu => hu.2, ?_⟩
      intro v hv
      have hub : (((⊥ : A), v) : A × B)
          ∈ upperBounds {u : A × B | u ∈ factorPart (A × B) ∧ u ≤ ((⊥ : A), b)} := by
        rintro ⟨c, d⟩ ⟨hcd, hle⟩
        have hc : c = ⊥ := le_bot_iff.mp hle.1
        subst hc
        rcases mem_factorPart_prod.mp hcd with ⟨hd, -⟩ | ⟨-, hd⟩
        · refine ⟨le_rfl, ?_⟩
          rw [hd]
          exact bot_le
        · exact ⟨le_rfl, hv ⟨hd, hle.2⟩⟩
      exact ((h ((⊥ : A), b)).2 hub).2
  · rintro ⟨hA, hB⟩ ⟨a, b⟩
    refine ⟨fun u hu => hu.2, ?_⟩
    rintro ⟨x, y⟩ hxy
    refine ⟨?_, ?_⟩
    · refine (hA a).2 ?_
      rintro u ⟨hu, hle⟩
      exact (hxy (show ((u, (⊥ : B)) : A × B) ∈ _ from
        ⟨mem_factorPart_prod.mpr (Or.inl ⟨rfl, hu⟩), ⟨hle, bot_le⟩⟩)).1
    · refine (hB b).2 ?_
      rintro u ⟨hu, hle⟩
      exact (hxy (show (((⊥ : A), u) : A × B) ∈ _ from
        ⟨mem_factorPart_prod.mpr (Or.inr ⟨rfl, hu⟩), ⟨bot_le, hle⟩⟩)).2

end Prod

/-! ## The restricted product is generated by its atom-factors -/

section WeakProdGen

variable {D : ℕ → Type u} [∀ j, PartialOrder (D j)] [∀ j, OrderBot (D j)]
variable (lam : ∀ j, D j)
variable (hlam_ne : ∀ j, lam j ≠ ⊥) (hlam_le : ∀ j (z : D j), z ≠ ⊥ → lam j ≤ z)

include hlam_ne hlam_le

theorem single_mem_factorPart (j : ℕ) (a : D j) :
    (single j a : WeakProd D) ∈ factorPart (WeakProd D) :=
  ⟨single j (lam j), isAtom_single lam hlam_ne hlam_le j,
   mem_atomFactor_single lam hlam_ne hlam_le a⟩

/-- **A restricted product is generated by its atom-factors** — `w` is the join
of its own coordinates, each of which lies on an axis. -/
theorem genByFactors_weakProd : GenByFactors (WeakProd D) := by
  intro w
  constructor
  · rintro u ⟨-, hle⟩
    exact hle
  · intro v hv j
    have hmem : (single j (w.1 j) : WeakProd D)
        ∈ {u : WeakProd D | u ∈ factorPart (WeakProd D) ∧ u ≤ w} :=
      ⟨single_mem_factorPart lam hlam_ne hlam_le j (w.1 j), single_le_iff.mpr le_rfl⟩
    exact single_le_iff.mp (hv hmem)

/-- **The criterion.**  A restricted product is never isomorphic to itself times
a factor that fails generation. -/
theorem weakProd_prod_ne {S : Type u} [PartialOrder S] [OrderBot S] [IsAtomic S]
    (hS : ¬ GenByFactors S) :
    IsEmpty (WeakProd D ≃o (WeakProd D × S)) := by
  haveI := isAtomic_weakProd lam hlam_ne hlam_le
  refine no_iso_of_genByFactors_ne (genByFactors_weakProd lam hlam_ne hlam_le) ?_
  intro hcon
  exact hS (genByFactors_prod_iff.mp hcon).2

end WeakProdGen

end AtomFactorGeneration
